DATABASE_URL="postgresql://splitexpenses:splitexpenses@localhost:5432/splitexpenses?schema=public"
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
# Frontend base URL, used for links in emails
APP_URL="http://localhost:5173"
# How often the debtor reminder job runs, in milliseconds (default: 1 hour)
REMINDER_INTERVAL_MS=3600000
# Where receipt files are stored (default: backend/uploads, which git ignores)
# UPLOADS_DIR=/var/lib/splitexpenses/uploads
