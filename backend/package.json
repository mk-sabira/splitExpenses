{
  "name": "splitexpenses-backend",
  "version": "1.0.0",
  "description": "Shared-expenses API",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "watch": "tsx scripts/watch-group.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "private": true
}
